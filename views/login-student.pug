doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title #{title} - STMS
    link(rel="stylesheet", href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
    link(rel="stylesheet", href="/stylesheet/style.css")
  body
    header.site-header
      .container
        .header-wrapper
          .logo-container
            a(href="/")
              i.fa-solid.fa-bus-simple
              span.brand-title STMS
          nav.main-nav
            ul.nav-list
              li.nav-item: a.nav-link(href="/") Home
              li.nav-item: a.nav-link(href="/routes") Routes
              li.nav-item: a.nav-link(href="/timetable") Timetable
              li.nav-item: a.nav-link(href="/notices") Notices
              li.nav-item: a.nav-link(href="/about") About
              li.nav-item: a.nav-link(href="/contact") Contact

          .header-actions
            .login-dropdown
              button#loginBtn.btn.btn-login(type="button")
                i.fas.fa-sign-in-alt
                |  Login 
                i.fas.fa-chevron-down.dropdown-icon
              .dropdown-menu#loginMenu
                a.dropdown-item(href="/login-student")
                  i.fas.fa-user-graduate
                  .item-text
                    strong Login as Student
                    span Access route schedules & pass
                a.dropdown-item(href="/login-driver")
                  i.fas.fa-id-card-clip
                  .item-text
                    strong Login as Driver
                    span Manage trips & updates
                a.dropdown-item(href="/signup")
                  i.fas.fa-user-plus
                  .item-text
                    strong Sign Up
                    span Create a new account
    main.page-shell
      .container
        .auth-layout
          .auth-card
            .auth-badge Student Portal
            h1 Welcome back
            p Access your bus schedules, notices and trip updates anytime.

            if message
              .alert.alert-success= message

            form.auth-form(action="/login-student", method="POST")
              .form-group
                label(for="studentEmail") Email address
                .input-wrapper
                  input#studentEmail.form-control(type="email", name="email", placeholder="name@metrouni.edu.bd", required)
                  i.fas.fa-envelope.input-icon

              .form-group
                label(for="studentId") Student ID
                .input-wrapper
                  input#studentId.form-control(type="text", name="studentId", placeholder="Enter your student ID", required)
                  i.fas.fa-id-card.input-icon

              .form-group
                label(for="studentPassword") Password
                .input-wrapper
                  input#studentPassword.form-control(type="password", name="password", placeholder="Enter your password", required)
                  i.fas.fa-lock.input-icon

              .form-options
                label.checkbox-row
                  input(type="checkbox", name="remember")
                  span Remember me
                a.forgot-link(href="/signup") Create account

              button.btn.btn-login(type="submit")
                i.fas.fa-sign-in-alt
                |  Sign In

            .auth-footer
              span Don't have an account?
              a(href="/signup") Sign up here

          .auth-sidebar
            h2 Student benefits
            ul.auth-list
              li
                i.fas.fa-calendar-check
                span Track route schedules
              li
                i.fas.fa-bell
                span Receive notices instantly
              li
                i.fas.fa-shield-alt
                span Secure student access
